table student

	partition student = m
		mode: import
		source =
				let
					Source = Sql.Database("contoso.example.cloud", "school"),
					student = Source{[Schema = "enrollment", Item = "student"]}[Data],
					#"Merged, Expanded" = Table.SelectRows(student, each [status] = "Active")
				in
					#"Merged, Expanded"
