table student
	lineageTag: 00000000-0000-0000-0000-000000000101

	measure 'Student Count' = COUNTROWS(student)
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000102

	column student_id
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000103
		summarizeBy: none
		sourceColumn: student_id

	column full_name
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000104
		summarizeBy: none
		sourceColumn: full_name

	column cohort_year
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000105
		summarizeBy: none
		sourceColumn: cohort_year

	partition student = m
		mode: import
		source =
				let
					Source = Sql.Database("sql.contoso.example.cloud", "registrar"),
					student = Source{[Schema = "school", Item = "student"]}[Data]
				in
					student

	annotation PBI_ResultType = Table

